# Production environment template — copy to .env and fill in real values

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-long-random-secret-key-here

DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
FRONTEND_URLS=https://yourdomain.com,https://www.yourdomain.com

# Database (PostgreSQL recommended for production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bcuams
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# Redis (required for WebSocket in multi-process production)
REDIS_URL=redis://localhost:6379

# Seeded admin account (manage.py seed, run on every container start - idempotent)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@bcu.local
DJANGO_SUPERUSER_PASSWORD=change-me

# Host port for the nginx service (docker-compose.yml). Override in the repo-root
# .env if 8080 is already taken on the deploy host.
HOST_HTTP_PORT=8080
